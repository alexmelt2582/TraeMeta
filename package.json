{
  "name": "trae-meta",
  "version": "2.0.0",
  "private": true,
  "description": "Trae Meta: desktop enhancement assistant for the merged TRAE (Trae CN)",
  "type": "module",
  "scripts": {
    "start": "node src/launcher.js",
    "daemon": "node src/daemon.js",
    "service": "node scripts/service.js",
    "watchdog": "node scripts/watchdog.js",
    "doctor": "node scripts/doctor.js",
    "build:exe": "node scripts/build-exe.js",
    "build:installer": "node scripts/win/build-installer.js",
